{
  "name": "optolith",
  "productName": "Optolith",
  "version": "2.0.0-alpha.1",
  "description": "A generator for heroes for the P&P-RPG 'The Dark Eye'.",
  "author": {
    "name": "Lukas Obermann",
    "email": "support@optolith.app"
  },
  "homepage": "https://optolith.app",
  "license": "MPL-2.0",
  "main": ".webpack/main.mjs",
  "dependencies": {
    "@optolith/database-schema": "^0.123.0",
    "electron-updater": "^6.8.11",
    "tsondb": "^0.23.5"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.2",
    "@elyukai/markdown": "^0.4.0",
    "@elyukai/oxc-config": "^0.1.5",
    "@elyukai/utils": "^0.3.16",
    "@optolith/adventure-points": "^0.1.3",
    "@optolith/character-schema": "^0.4.0",
    "@optolith/entity-descriptions": "^0.46.2",
    "@reduxjs/toolkit": "^2.13.0",
    "@rsdoctor/core": "^2.0.0",
    "@rspack/cli": "^2.2.9",
    "@rspack/core": "^2.2.9",
    "@types/mousetrap": "^1.6.15",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-redux": "^7.1.35",
    "@types/semver": "^7.8.0",
    "@types/ssh2-sftp-client": "^9.0.6",
    "adm-zip": "^0.6.1",
    "commit-and-tag-version": "^13.3.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.5",
    "debug": "^4.4.3",
    "electron": "^45.2.0",
    "electron-builder": "^26.18.0",
    "eslint-plugin-mobx": "^0.2.1",
    "events": "^3.3.0",
    "glob": "^13.0.6",
    "globals": "^17.13.0",
    "html-webpack-plugin": "^5.6.8",
    "immer": "^11.2.9",
    "messageformat": "^4.1.0",
    "mobx": "^7.1.1",
    "mobx-react-lite": "^5.1.2",
    "moment": "^2.31.0",
    "mousetrap": "^1.6.5",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2005",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.3.0",
    "rehype-raw": "^7.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "resolve-url-loader": "^5.0.0",
    "sass": "^1.106.1",
    "sass-loader": "^17.0.1",
    "semver": "^7.8.5",
    "ssh2-sftp-client": "^12.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "format": "oxfmt \"{src,test}/**/*.{ts,tsx}\"",
    "format:check": "oxfmt \"{src,test}/**/*.{ts,tsx}\" --check",
    "prerelease:win": "cross-env NODE_ENV=development CHANNEL=prerelease electron-builder -w",
    "prerelease:linux": "cross-env NODE_ENV=development CHANNEL=prerelease electron-builder -l",
    "prerelease:mac": "cross-env NODE_ENV=development CHANNEL=prerelease electron-builder -m",
    "prerelease": "cross-env NODE_ENV=development CHANNEL=prerelease electron-builder -mwl",
    "stable:win": "cross-env NODE_ENV=production CHANNEL=stable electron-builder -w",
    "stable:linux": "cross-env NODE_ENV=production CHANNEL=stable electron-builder -l",
    "stable:mac": "cross-env NODE_ENV=production CHANNEL=stable electron-builder -m",
    "stable": "cross-env NODE_ENV=production CHANNEL=stable electron-builder -mwl",
    "js:build": "cross-env NODE_ENV=production rspack build",
    "js:profile": "cross-env RSDOCTOR=true rspack build",
    "js:watch": "cross-env NODE_ENV=development rspack build -w",
    "ts:build": "tsc",
    "ts:watch": "tsc -w",
    "lint": "oxlint",
    "compressdb": "tsondb -c ./src/database/contents/tsondb.config.ts compress -p ./.webpack/data",
    "start": "cross-env DEBUG=\"*\" electron --js-flags='--stack-size=5000' --trace-warnings .",
    "test": "node --import tsx --test",
    "release:main": "standard-version --skip.commit --skip.tag",
    "release:pre": "standard-version --prerelease=alpha",
    "buildicns": "iconutil -c icns src/assets/icon/AppIcon.iconset && iconutil -c icns src/assets/icon/AppIcon.pre.iconset",
    "rsd": "rsdoctor analyze --profile .rsdoctor/manifest.json"
  },
  "repository": "github:elyukai/optolith-client",
  "type": "module",
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "cpu-features@0.0.10": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "ssh2@1.17.0": true
  }
}
